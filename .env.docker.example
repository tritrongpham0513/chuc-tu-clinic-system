# ============================================================================
# CẤU HÌNH MÔI TRƯỜNG DOCKER COMPOSE (.env.docker.example)
# ============================================================================
# Tùy chọn: Sao chép file này thành .env nếu muốn tùy chỉnh cổng hoặc tài khoản.
# Mặc định Docker Compose đã tích hợp giá trị fallback nên có thể chạy ngay lập tức.
# ============================================================================

# --- CỔNG DỊCH VỤ TRÊN MÁY CHỦ (HOST PORTS) ---
FRONTEND_PORT=3000
BACKEND_PORT=8080
DB_PORT=3307

# --- CƠ SỞ DỮ LIỆU MYSQL ---
DB_NAME=phongkham_chuctu
DB_ROOT_PASSWORD=root
DB_USERNAME=chuctu_user
DB_PASSWORD=chuctu_password

# --- TÀI KHOẢN QUẢN TRỊ VIÊN ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=MatKhauAdmin@2026
ADMIN_PHONE=0912345678
ADMIN_FULL_NAME=Quản trị viên Phòng khám

# --- CỔNG SMS OTP (eSMS.vn) ---
SMS_ENABLED=false
SMS_PROVIDER=esms
SMS_API_KEY=
SMS_SECRET_KEY=
SMS_TYPE=2
SMS_BRAND_NAME=Baotrixemay

