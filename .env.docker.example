# ============================================================================
# CẤU HÌNH MÔI TRƯỜNG DOCKER COMPOSE (.env.docker.example)
# ============================================================================
# Tùy chọn: Sao chép file này thành .env nếu muốn tùy chỉnh cổng hoặc tài khoản.
# Mặc định Docker Compose đã tích hợp giá trị fallback nên có thể chạy ngay lập tức.
# ============================================================================

# --- CỔNG DỊCH VỤ TRÊN MÁY CHỦ (HOST PORTS) ---
FRONTEND_PORT=3000
BACKEND_PORT=4000
DB_PORT=3307
SPRING_PROFILES_ACTIVE=prod

# --- BẢO MẬT & XÁC THỰC (BẮT BUỘC) ---
# Khóa JWT bí mật Base64 tối thiểu 32 byte (256-bit). Tạo bằng: openssl rand -base64 32
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
DDL_AUTO=validate
OTP_EXPOSE_DEV_CODE=false

# --- CƠ SỞ DỮ LIỆU MYSQL ---
DB_NAME=phongkham_chuctu
DB_ROOT_PASSWORD=root
DB_USERNAME=chuctu_user
DB_PASSWORD=chuctu_password

# --- TÀI KHOẢN QUẢN TRỊ VIÊN ---
ADMIN_USERNAME=admin
# Bắt buộc đặt khi triển khai (tối thiểu 8 ký tự)
ADMIN_PASSWORD=
ADMIN_PHONE=0912345678
ADMIN_FULL_NAME=Quản trị viên Phòng khám

# --- CỔNG SMS OTP (eSMS.vn) & THÔNG BÁO ---
NOTIFICATION_PROVIDER=log
SMS_ENABLED=false
SMS_PROVIDER=esms
SMS_API_KEY=
SMS_SECRET_KEY=
SMS_TYPE=2
SMS_BRAND_NAME=Baotrixemay

