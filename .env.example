# ============================================================================
# MẪU CẤU HÌNH MÔI TRƯỜNG (.env.example) - PHÒNG KHÁM CHÚC TỪ
# ============================================================================
# Sao chép file này thành .env và điền thông tin tương ứng.
# ============================================================================

# --- 1. CƠ SỞ DỮ LIỆU MYSQL ---
DB_URL=jdbc:mysql://localhost:3306/phongkham_chuctu?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=UTF-8&allowPublicKeyRetrieval=true
DB_TEST_URL=jdbc:mysql://localhost:3306/phongkham_chuctu_test?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=UTF-8&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# --- 2. CẤU HÌNH CỔNG SERVER BACKEND ---
PORT=8080

# --- 3. TÀI KHOẢN ADMIN MẶC ĐỊNH ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=MatKhauAdmin@2026
ADMIN_PHONE=0912345678
ADMIN_FULL_NAME=Quản trị viên Phòng khám

# --- 4. CẤU HÌNH CỔNG GỬI TIN NHẮN SMS OTP (eSMS.vn) ---
SMS_ENABLED=false
SMS_PROVIDER=esms
SMS_API_KEY=
SMS_SECRET_KEY=
# 2: Brandname CSKH/OTP | 8: Đầu số cố định
SMS_TYPE=2
SMS_BRAND_NAME=Baotrixemay

